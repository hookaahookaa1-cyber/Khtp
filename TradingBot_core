                initial_capital,
                current_equity,
                peak_equity,
                realized_pnl,
                total_deposits,
                total_withdrawals,
                total_fees,
                total_funding,
                updated_at
            FROM portfolio
            WHERE id = 1
            """)

            row = cur.fetchone()

            if not row:
                return None

            (
                initial_capital,
                current_equity,
                peak_equity,
                realized_pnl,
                total_deposits,
                total_withdrawals,
                total_fees,
                total_funding,
                updated_at
            ) = row

            drawdown = (
                ((peak_equity - current_equity) / peak_equity) * 100
                if peak_equity > 0
                else 0
            )

            return {
                "initial_capital": initial_capital,
                "current_equity": current_equity,
                "peak_equity": peak_equity,
                "realized_pnl": realized_pnl,
                "total_deposits": total_deposits,
                "total_withdrawals": total_withdrawals,
                "total_fees": total_fees,
                "total_funding": total_funding,
                "drawdown_pct": drawdown,
                "updated_at": updated_at
            }

